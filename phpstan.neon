parameters:
    level: max
    paths:
        - src/
        - tests/
        - public/index.php
        - bin/worker.php
    strictRules:
        allRules: true
    checkMissingIterableValueType: true
    checkUninitializedProperties: true
    checkTooWideReturnTypes: true
    treatPhpDocTypesAsCertain: false
    tmpDir: .phpstan-cache