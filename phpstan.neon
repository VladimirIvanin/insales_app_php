parameters:
    level: max
    paths:
        - src/
        - tests/
        - public/index.php
        - bin/app.php
    strictRules:
        allRules: false
        booleansInConditions: true
        requireParentConstructorCall: true
    checkMissingIterableValueType: true
    checkUninitializedProperties: true
    treatPhpDocTypesAsCertain: false
    tmpDir: .phpstan-cache