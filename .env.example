# InSales application credentials (from InSales partner cabinet)
INSALES_APP_ID=your_app_id
INSALES_APP_SECRET=your_app_secret

# Your application public base URL (used for login redirects)
APP_BASE_URL=http://127.0.0.1:8765

# Comma-separated list of allowed shop domains for installation
ALLOWED_SHOPS=demo.myinsales.ru

# Encryption key for stored passwords (32 bytes, hex-encoded)
# Generate: php -r 'echo bin2hex(sodium_crypto_secretbox_keygen());'
APP_ENCRYPTION_KEY=

# Database path (SQLite file)
APP_DB_PATH=runtime/app.sqlite3

# Application environment: development (default) or production
APP_ENV=development

# Bind address and port for built-in PHP server
BIND_HOST=127.0.0.1
PORT=8765