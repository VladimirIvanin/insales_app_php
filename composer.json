{
    "name": "insales/partner-app-php",
    "description": "InSales Partner Application scaffold (PHP 8.4+)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-strict-rules": "^1.6",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "InSales\\": "src/InSales/",
            "Application\\": "src/Application/",
            "Http\\": "src/Http/",
            "Infrastructure\\": "src/Infrastructure/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "analyse": "phpstan analyse --level=max src/ tests/",
        "lint": "phpcs --standard=PSR12 --colors src/ tests/",
        "lint:fix": "phpcbf --standard=PSR12 --colors src/ tests/",
        "audit": "composer audit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
